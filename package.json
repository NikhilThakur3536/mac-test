{
  "name": "logger",
  "version": "1.0.0",
  "description": "This app basically logs the activity of logged in user and also display its idle times. Moreover it also takes entire desktop screenshot after every n interval of time which would be decided by the admin.",
  "main": "main/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && electron-builder",
    "start": "next start && electron .",
    "electron-dev": "electron .",
    "format": "prettier --write .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.infoware-logger.123",
    "productName": "System Tracker",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "System Tracker"
    },
    "mac": {
      "target": "dmg", 
      "hardenedRuntime": true, 
      "entitlements": "entitlements.mac.plist", 
      "entitlementsInherit": "entitlements.mac.plist", 
      "gatekeeperAssess": false,  
      "identity": "Developer ID Application: Hemant Agarwal (44ZZF669W5)"  
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "next": "^15.0.2",
    "postcss": "^8.4.47",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14"
  },
  "dependencies": {
    "apexcharts": "^3.54.1",
    "axios": "^1.7.7",
    "electron-is-dev": "^3.0.1",
    "electron-settings": "^4.0.4",
    "get-windows": "^9.2.0",
    "lucide-react": "^0.454.0",
    "moment": "^2.30.1",
    "node-global-key-listener": "^0.3.0",
    "react-apexcharts": "^1.5.0",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "socket.io-client": "^4.8.1",
    "uiohook-napi": "^1.5.4"
  }
}
